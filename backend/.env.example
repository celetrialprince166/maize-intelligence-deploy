# Backend Environment Configuration
# All variables below are REQUIRED — app/config.py raises at import time if
# any are unset. There are no hardcoded fallback values in code.

# AWS
AWS_REGION=us-east-1
S3_BUCKET=maize-intelligence-models-104702104957

# DynamoDB
DYNAMODB_FARMS_TABLE=maize-intelligence-farms
DYNAMODB_USERS_TABLE=maize-intelligence-users

# AWS Cognito (JWT token verification)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_vfe6JbU6G
COGNITO_CLIENT_ID=744ah7v7iddsshrm9mm02bnd9i

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5174

# Google Earth Engine service account key — absolute path to the JSON key
# file on disk. In production this is written by the host at container
# start from AWS Secrets Manager; never commit the actual key file.
GEE_SERVICE_ACCOUNT_KEY=/run/secrets/gee-key.json
